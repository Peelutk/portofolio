{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portofolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /admin selalu lewat Worker dulu supaya token Cloudflare Access diverifikasi
    "run_worker_first": ["/admin", "/admin/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db_portofolio",
      "database_id": "8b8caa5e-56d2-47c8-b916-087d0c2e1d81",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Diisi setelah Cloudflare Access dipasang (bukan rahasia). Kosong = admin terkunci.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
